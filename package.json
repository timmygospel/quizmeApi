{
  "name": "mfquiz-api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "predev": "docker compose up -d --wait",
    "dev": "ts-node-dev --respawn --transpile-only --no-notify src/server.ts",
    "start": "node dist/server.js",
    "prestart:watch": "docker compose up -d --wait",
    "start:watch": "nodemon --watch src --ext ts --exec \"npm run build && node dist/server.js\"",
    "lint": "eslint . --ext .ts,.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:migrate": "ts-node src/shared/infra/postgres/migrate.ts",
    "bootstrap:admin": "ts-node src/shared/infra/postgres/bootstrapAdmin.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.9",
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "ioredis": "^5.9.3",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.33",
    "@types/pg": "^8.20.0",
    "@types/socket.io": "^3.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
