PORT=4000
DATABASE_URL=postgres://quizmeapi:quizmeapi@localhost:5432/quizmeapi
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# AUTH-001 — pluggable authentication (see src/shared/infra/auth/).
# AUTH_PROVIDER selects the IAuthProvider implementation; "clerk" is the
# only one wired up today. Leave CLERK_SECRET_KEY unset to run with auth
# disabled (req.authUser is simply never populated).
AUTH_PROVIDER=clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Comma-separated list of extra allowed CORS/Socket.IO origins, on top of
# http://localhost:5173 (always allowed) and the production origin. Use this
# to test through a Cloudflare Tunnel (e.g. https://dev.quizanalytics.co.uk)
# without exposing the API on localhost directly — see
# QuizAnalytics_Local_Live_Quiz_Dev_Setup for the full setup. Leave unset (or
# just remove the tunnel entry) to go back to plain localhost development.
CORS_EXTRA_ORIGINS=
