PORT=4000
DATABASE_URL=postgres://quizmeapi:quizmeapi@localhost:5432/quizmeapi
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# AUTH-001 — pluggable authentication (see src/shared/infra/auth/).
# AUTH_PROVIDER selects the IAuthProvider implementation; "clerk" is the
# only one wired up today. Leave CLERK_SECRET_KEY unset to run with auth
# disabled (req.authUser is simply never populated).
AUTH_PROVIDER=clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
