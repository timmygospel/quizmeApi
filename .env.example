# Copy this file to .env and fill in the values
# cp .env.example .env

# ---------------------------
# Server
# ---------------------------
PORT=4000
NODE_ENV=development

# ---------------------------
# PostgreSQL Connection (Prisma)
# ---------------------------
# Local (matches docker-compose.yml defaults):
DATABASE_URL="postgres://postgres:postgres@localhost:5433/app_dev?schema=quizme"
# Production (Fly.io Postgres example):
# DATABASE_URL="postgres://user:password@host.flycast:5432/dbname?schema=quizme&sslmode=disable"

# ---------------------------
# Redis Connection
# ---------------------------
# Local (matches docker-compose.yml defaults):
REDIS_URL=redis://localhost:6379
# Production (Fly.io Redis / Upstash example):
# REDIS_URL=redis://default:<password>@<host>:6379

# ---------------------------
# Auth
# ---------------------------
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-in-production
